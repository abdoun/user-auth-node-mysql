MYSQL_ROOT_PASSWORD=replace_with_a_strong_unique_password
DB_USER=auth_user
DB_PASS=replace_with_another_strong_password
DB_NAME=user_auth
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated browser origins allowed to call this API. Include every
# origin a frontend is opened from, with its scheme and port, e.g.
# http://192.168.1.50:8088, https://authors-example.example.com
CORS_ORIGIN=http://localhost:3001,http://localhost:3000,http://localhost:3002,http://authors-example,http://authors-backend